{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://code-quality.local/schemas/mining-result-1.0.0.json",
  "title": "Historical defect mining result",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "repo": { "type": "string" },
    "fix_commit": { "type": "string" },
    "fix_subject": { "type": "string" },
    "scope": { "type": "string", "enum": ["IN_SCOPE", "OUT_OF_SCOPE"] },
    "rule_id": {
      "type": "string",
      "enum": [
        "DES-001", "DES-002", "DES-003", "DES-004", "DES-005",
        "COR-001", "COR-002", "COR-003", "COR-004", "COR-005",
        "REL-001", "REL-002", "REL-003", "REL-004", "REL-005",
        "SEC-001", "SEC-002", "SEC-003", "CHG-001", "CHG-002",
        "OUT_OF_SCOPE"
      ]
    },
    "defect_class": {
      "type": "string",
      "enum": ["wrong_code", "missing_safeguard"]
    },
    "material": { "type": "boolean" },
    "static_detectable": { "type": "boolean" },
    "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
    "introducing_commit": { "type": "string" },
    "evidence_chain": {
      "type": "array",
      "items": { "type": "string" }
    },
    "defect": { "type": "string" },
    "defect_class_basis": { "type": "string" }
  },
  "required": [
    "schema_version", "repo", "fix_commit", "fix_subject", "scope", "rule_id",
    "defect_class", "material", "static_detectable", "difficulty",
    "introducing_commit", "evidence_chain", "defect", "defect_class_basis"
  ]
}
