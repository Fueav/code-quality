package main

import "os"

type Resource struct {
	ID       string
	TenantID string
	Value    string
}

type Repository struct{ rows []Resource }

func (repository *Repository) Update(id, value string) bool {
	for index := range repository.rows {
		row := &repository.rows[index]
		if row.ID == id {
			row.Value = value
			return true
		}
	}
	return false
}

