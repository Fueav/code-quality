{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "release", "review_scope", "review_key", "current_head", "blocking_issues", "advisory_issues", "resolved_previous_findings", "unresolved_previous_findings", "new_findings", "issues"],
  "properties": {
    "schema_version": {"const": 3},
    "result": {"enum": ["PASS", "BLOCK", "ERROR"]},
    "release": {"enum": ["CONTINUE", "HOLD"]},
    "review_scope": {"enum": ["FULL", "INCREMENTAL"]},
    "review_key": {"type": "string", "pattern": "^review-v1:sha256:[0-9a-f]{64}$"},
    "current_head": {"type": "string", "minLength": 1},
    "blocking_issues": {"type": "integer", "minimum": 0},
    "advisory_issues": {"type": "integer", "minimum": 0},
    "resolved_previous_findings": {"type": "integer", "minimum": 0},
    "unresolved_previous_findings": {"type": "integer", "minimum": 0},
    "new_findings": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["priority", "title", "location", "reason", "suggestion"],
        "properties": {
          "priority": {"enum": ["P0", "P1", "P2", "P3"]},
          "title": {"type": "string", "minLength": 1, "maxLength": 160},
          "location": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1, "maxLength": 1000},
          "suggestion": {"type": "string", "minLength": 1, "maxLength": 1000}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "PASS"}}},
      "then": {
        "properties": {
          "release": {"const": "CONTINUE"},
          "blocking_issues": {"const": 0},
          "issues": {"items": {"type": "object", "properties": {"priority": {"enum": ["P2", "P3"]}}}}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "BLOCK"}}},
      "then": {
        "properties": {
          "release": {"const": "HOLD"},
          "blocking_issues": {"minimum": 1},
          "issues": {"minItems": 1, "contains": {"type": "object", "required": ["priority"], "properties": {"priority": {"enum": ["P0", "P1"]}}}, "minContains": 1}
        }
      }
    },
    {
      "if": {"properties": {"result": {"const": "ERROR"}}},
      "then": {
        "properties": {
          "release": {"const": "HOLD"},
          "blocking_issues": {"const": 0},
          "advisory_issues": {"const": 0},
          "resolved_previous_findings": {"const": 0},
          "unresolved_previous_findings": {"const": 0},
          "new_findings": {"const": 0},
          "issues": {"maxItems": 0}
        }
      }
    }
  ]
}
