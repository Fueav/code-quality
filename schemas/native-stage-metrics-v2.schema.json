{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "stage", "attempt", "duration_ms", "input_tokens", "output_tokens", "cached_input_tokens", "cached_input_tokens_available", "usage_available", "changed_file_count", "trusted_diff_bytes"],
  "properties": {
    "schema_version": {"const": 2},
    "stage": {"enum": ["NATIVE", "RESTRICTED"]},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "duration_ms": {"type": "integer", "minimum": 0},
    "input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "output_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens": {"type": ["integer", "null"], "minimum": 0},
    "cached_input_tokens_available": {"type": "boolean"},
    "cached_input_tokens_error": {"type": "string", "minLength": 1},
    "usage_available": {"type": "boolean"},
    "usage_error": {"type": "string", "minLength": 1},
    "changed_file_count": {"type": "integer", "minimum": 0},
    "trusted_diff_bytes": {"type": "integer", "minimum": 0}
  },
  "allOf": [
    {
      "if": {"properties": {"usage_available": {"const": true}}},
      "then": {
        "not": {"required": ["usage_error"]},
        "properties": {
          "input_tokens": {"type": "integer"},
          "output_tokens": {"type": "integer"}
        }
      },
      "else": {
        "required": ["usage_error"],
        "properties": {
          "input_tokens": {"type": "null"},
          "output_tokens": {"type": "null"},
          "cached_input_tokens": {"type": "null"},
          "cached_input_tokens_available": {"const": false}
        }
      }
    },
    {
      "if": {"properties": {"cached_input_tokens_available": {"const": true}}},
      "then": {
        "not": {"required": ["cached_input_tokens_error"]},
        "properties": {"cached_input_tokens": {"type": "integer"}}
      },
      "else": {
        "properties": {"cached_input_tokens": {"type": "null"}},
        "anyOf": [
          {"required": ["usage_error"]},
          {"required": ["cached_input_tokens_error"]}
        ]
      }
    }
  ]
}
