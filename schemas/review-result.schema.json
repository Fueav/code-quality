{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_version", "request", "activated_rule_families", "inactive_rule_families", "findings", "execution", "uninspected_scope", "missing_context", "inspected_context", "adjudication"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_version": {"type": "string", "minLength": 1},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "target_branch", "base_commit", "target_commit", "diff_selection_reason", "changed_files", "affected_entries"],
      "properties": {
        "repository": {"type": "string"},
        "target_branch": {"type": "string"},
        "base_commit": {"type": "string"},
        "target_commit": {"type": "string"},
        "diff_selection_reason": {"type": "string"},
        "changed_files": {"type": "array", "items": {"type": "string"}},
        "affected_entries": {"type": "array", "items": {"type": "string"}},
        "change": {"$ref": "#/$defs/change"}
      }
    },
    "activated_rule_families": {"type": "array", "items": {"$ref": "#/$defs/dimension"}, "uniqueItems": true},
    "inactive_rule_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"$ref": "#/$defs/dimension"},
          "reason": {"type": "string"}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/adjudicated_finding"}},
    "execution": {"$ref": "#/$defs/execution"},
    "uninspected_scope": {"type": "array", "items": {"type": "string"}},
    "missing_context": {"type": "array", "items": {"type": "string"}},
    "inspected_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    },
    "adjudication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic_result", "rollout_mode", "ci_action", "reasons"],
      "properties": {
        "semantic_result": {"enum": ["PASS", "MANUAL_REVIEW", "BLOCK", "INCOMPLETE"]},
        "rollout_mode": {"const": "report_only"},
        "ci_action": {"const": "publish_report"},
        "reasons": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "base_ref", "head_ref", "base_tip_commit"],
      "properties": {
        "kind": {"enum": ["pull_request", "merge_request"]},
        "id": {"type": "string", "minLength": 1},
        "base_ref": {"type": "string", "minLength": 1},
        "head_ref": {"type": "string", "minLength": 1},
        "base_tip_commit": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "run_url": {"type": "string", "minLength": 1}
      }
    },
    "dimension": {"enum": ["D1", "D2", "D3", "D4"]},
    "rule_id": {
      "enum": [
        "DES-001", "DES-002", "DES-003", "DES-004", "DES-005",
        "COR-001", "COR-002", "COR-003", "COR-004", "COR-005",
        "REL-001", "REL-002", "REL-003", "REL-004", "REL-005",
        "SEC-001", "SEC-002", "SEC-003",
        "CHG-001", "CHG-002"
      ]
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "skill_version", "agent_count", "verifier_count", "input_tokens", "output_tokens", "duration_ms", "retry_count"],
      "properties": {
        "host": {"enum": ["claude-code", "codex", ""]},
        "skill_version": {"type": "string"},
        "agent_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "verifier_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "duration_ms": {"type": ["integer", "null"], "minimum": 0},
        "retry_count": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "code_locations", "production_impact", "minimal_fix"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_id": {"$ref": "#/$defs/rule_id"},
        "code_locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
        "production_impact": {"type": "string", "minLength": 1},
        "minimal_fix": {"type": "string", "minLength": 1}
      }
    },
    "adjudicated_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate", "final_verdict"],
      "properties": {
        "candidate": {"$ref": "#/$defs/finding"},
        "final_verdict": {"enum": ["MANUAL_REVIEW", "BLOCK"]}
      }
    }
  }
}
