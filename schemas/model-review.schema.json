{
  "type": "object",
  "additionalProperties": false,
  "required": ["activated_rule_families", "inactive_rule_families", "findings", "uninspected_scope", "missing_context", "inspected_context"],
  "properties": {
    "activated_rule_families": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "inactive_rule_families": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "uninspected_scope": {"type": "array", "items": {"type": "string"}},
    "missing_context": {"type": "array", "items": {"type": "string"}},
    "inspected_context": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "purpose": {"type": "string", "minLength": 1}
        }
      }
    }
  },
  "$defs": {
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule_id", "proposed_verdict", "severity", "trigger_confidence", "evidence_level", "introduced_or_worsened_by_change", "finding_is_not_style_preference", "code_locations", "affected_call_path", "trigger_condition", "causal_chain", "production_impact", "verification_performed", "minimal_fix", "uncertainties", "verifier_result"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_id": {"type": "string", "minLength": 1},
        "proposed_verdict": {"enum": ["MANUAL_REVIEW", "BLOCK"]},
        "severity": {"enum": ["S1", "S2", "S3"]},
        "trigger_confidence": {"enum": ["T1", "T2", "T3"]},
        "evidence_level": {"enum": ["E1", "E2", "E3"]},
        "introduced_or_worsened_by_change": {"type": "boolean"},
        "finding_is_not_style_preference": {"type": "boolean"},
        "code_locations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/location"}},
        "affected_call_path": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "trigger_condition": {"type": "string", "minLength": 1},
        "causal_chain": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "production_impact": {"type": "string", "minLength": 1},
        "verification_performed": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "minimal_fix": {"type": "string", "minLength": 1},
        "uncertainties": {"type": "array", "items": {"type": "string"}},
        "verifier_result": {"const": "not_run"}
      }
    }
  }
}
